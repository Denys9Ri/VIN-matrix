# Django
DJANGO_SETTINGS_MODULE=vin_matrix.settings_growth
DEBUG=False
SECRET_KEY=change-me-use-a-long-random-secret-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173
APP_VERSION=2026.06
LOG_LEVEL=INFO

# Enable only after HTTPS is configured at the proxy.
SECURE_SSL_REDIRECT=False
USE_X_FORWARDED_PROTO=False
SECURE_HSTS_SECONDS=0

# Database
USE_POSTGRES=True
DB_NAME=vin_matrix_db
DB_USER=vin_matrix
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Frontend
VITE_API_BASE_URL=http://localhost/api
# Google Analytics 4 Measurement ID, for example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Landing Growth Engine
# Search Console property exactly as configured in Google: https://vin-matrix.com/ or sc-domain:vin-matrix.com
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional OAuth fallback. A service account is recommended for production.
GOOGLE_OAUTH_REFRESH_TOKEN=
# Accepts a mounted JSON file path, raw service-account JSON, or base64(JSON).
GOOGLE_APPLICATION_CREDENTIALS=
GA4_PROPERTY_ID=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=600

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
LANDING_GROWTH_SIGNING_KEY=
LANDING_GROWTH_CANONICAL_URL=https://vin-matrix.com/
# Coolify deploy webhook. It is called only for SEO apply/rollback operations.
DEPLOY_TRIGGER_URL=
# Optional bearer token for a custom deploy proxy.
LANDING_GROWTH_DEPLOY_TOKEN=
# AUTO selects GET for Coolify /api/v1/deploy?uuid=... URLs and POST for generic webhooks.
LANDING_GROWTH_DEPLOY_METHOD=AUTO
# Autonomous worker interval. Minimum enforced value is one hour.
LANDING_GROWTH_INTERVAL_SECONDS=21600
LANDING_GROWTH_INITIAL_DELAY_SECONDS=120
LANDING_GROWTH_LOCK_MINUTES=90
# Optional explicit config endpoint for frontend Docker builds.
LANDING_GROWTH_BUILD_CONFIG_URL=https://vin-matrix.com/api/landing-growth/config/

# VIN-matrix Agent / Telegram
# Create the bot through @BotFather. Keep both values only in the server-side .env.
TELEGRAM_AGENT_BOT_TOKEN=
TELEGRAM_AGENT_WEBHOOK_SECRET=
# Optional public HTTPS endpoint. When empty, VIN-matrix derives it from the current API host.
# TELEGRAM_AGENT_WEBHOOK_URL=https://api.example.com/api/agent/telegram/webhook/

# Operations / server-side backups
# Host directory mounted into containers as /backups.
POSTGRES_BACKUP_DIR=./backups
BACKUP_DIR=/backups
BACKUP_KEEP=14
# PG_DUMP_PATH=pg_dump
